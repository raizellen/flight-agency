<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>

<VBox alignment="CENTER" styleClass="background" prefHeight="200.0" prefWidth="800.0" spacing="20"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AgencyController">
    
    <ImageView>
        <fitWidth>800</fitWidth>
        <preserveRatio>true</preserveRatio>
        <Image url="/image/agency.png"/>
    </ImageView>
    
    <Separator/>
    <Label fx:id="welcomeLbl" styleClass="heading"/>
    <Separator/>

    <HBox alignment="CENTER">
        <Button styleClass="button" prefWidth="200.0" text="Explore Flights" onAction="#handleFlight"/>
        <Button styleClass="button" prefWidth="200.0" text="Explore Destinations" onAction="#handleDestination"/>
        <Button styleClass="button" prefWidth="200.0" text="Book a Trip" onAction="#handleTrip"/>
        <Button styleClass="button" prefWidth="200.0" text="Exit" onAction="#handleExit"/>
    </HBox>

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
</VBox>
