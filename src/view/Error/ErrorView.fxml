<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>

<VBox alignment="CENTER" styleClass="background" prefHeight="250.0" prefWidth="400.0" spacing="20"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Error.ErrorController">
    
    <ImageView>
        <fitWidth>400</fitWidth>
        <preserveRatio>true</preserveRatio>
        <Image url="/image/error.png"/>
    </ImageView>

    <Separator/>
    <Label text="Error" styleClass="heading"/>
    <Separator/>

    <Label fx:id="errorLbl" styleClass="errorLabel"/>
    <Label fx:id="messageLbl" styleClass="label"/>

    <Button text="Close" styleClass="button" onAction="#handleClose" prefWidth="400.0"/>

    <stylesheets>
        <URL value="@/view/style.css"/>
    </stylesheets>
</VBox>