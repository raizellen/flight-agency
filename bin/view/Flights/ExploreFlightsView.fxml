<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Pos?>

<VBox alignment="CENTER" styleClass="background" prefHeight="200.0" prefWidth="600.0" spacing="20"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Flights.ExploreFlightsController">
    
    <ImageView>
        <fitWidth>600</fitWidth>
        <preserveRatio>true</preserveRatio>
        <Image url="/image/flight.png"/>
    </ImageView>
    
    <Separator/>
    <Label fx:id="welcomeLbl" styleClass="heading"/>
    <Separator/>

    <HBox alignment="CENTER">
        <Button styleClass="button" prefWidth="120.0" text="View All Flights" onAction="#handleViewAll"/>
        <Button styleClass="button" prefWidth="120.0" text="View Flights By Country" onAction="#handleViewCountry"/>
        <Button styleClass="button" prefWidth="120.0" text="Add Flight" onAction="#handleAddFlight"/>
        <Button styleClass="button" prefWidth="120.0" text="Remove Flight" onAction="#handleRemoveFlight"/>
        <Button styleClass="button" prefWidth="120.0" text="Close" onAction="#handleClose"/>
    </HBox>

    <stylesheets>
        <URL value="@/view/style.css"/>
    </stylesheets>
</VBox>